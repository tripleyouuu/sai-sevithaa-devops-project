region      = "ap-south-1"
project     = "syllabus"
environment = "dev"

vpc_cidr = "10.20.0.0/16"
az_count = 2

cluster_version     = "1.33"
node_instance_types = ["t3.medium"]
node_min_size       = 2
node_desired_size   = 2
node_max_size       = 4

admin_principal_arns = [
  "arn:aws:iam::123456789012:user/github-actions-deploy",
]
